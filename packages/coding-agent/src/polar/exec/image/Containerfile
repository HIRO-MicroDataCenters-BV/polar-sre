# The guest environment of the exec tool: Debian 13 with Python 3.13, the Python kit from requirements.txt
# and the CLI kit. Built for linux/arm64; the yq and duckdb downloads below are arm64 binaries.
# Build (from this directory):
#   container build --arch arm64 --tag polar-exec:0.1 --file Containerfile .
# Versions of everything inside the image are listed in /README.md of the image.
FROM python:3.13-slim@sha256:70729b46c69b4f1e97c4822c1af3df53a1476cf5ddc6c087c0c10bc3a5678c2f

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
	PIP_NO_CACHE_DIR=1 \
	PYTHONDONTWRITEBYTECODE=1 \
	PYTHONUNBUFFERED=1 \
	LANG=C.UTF-8

RUN apt-get update \
	&& apt-get install -y --no-install-recommends ripgrep jq gawk miller \
	&& rm -rf /var/lib/apt/lists/*

# mikefarah/yq v4.54.1 (MIT) and the duckdb CLI v1.5.6 (MIT), pinned by the sha256 of the release assets.
ADD --checksum=sha256:189088da0c6429ec5178dfaab1a114805f6cab0b61b165ab236efedf1d57a71b \
	https://github.com/mikefarah/yq/releases/download/v4.54.1/yq_linux_arm64 /usr/local/bin/yq
ADD --checksum=sha256:c544e92c9b7c31fc53c2139802cabd8e2d1b2b3e3f933117f31611239c1402db \
	https://github.com/duckdb/duckdb/releases/download/v1.5.6/duckdb_cli-linux-arm64.zip /tmp/duckdb_cli.zip
RUN chmod 0755 /usr/local/bin/yq \
	&& python3 -c "import zipfile; zipfile.ZipFile('/tmp/duckdb_cli.zip').extract('duckdb', '/usr/local/bin')" \
	&& chmod 0755 /usr/local/bin/duckdb \
	&& rm /tmp/duckdb_cli.zip

COPY requirements.txt /tmp/requirements.txt
RUN pip install --require-hashes --no-deps --requirement /tmp/requirements.txt \
	&& rm /tmp/requirements.txt

# The code runs as the unprivileged user pi. /data and /work are mount points; the runner mounts the
# session directory read-only at /data and the session volume at /work.
RUN useradd --uid 1000 --user-group --home-dir /work --no-create-home --shell /bin/bash pi \
	&& mkdir -p /data /work \
	&& chown pi:pi /work

RUN { \
	echo "# polar-exec image"; \
	echo; echo "Debian: $(. /etc/os-release && echo "$PRETTY_NAME")"; \
	echo "Python: $(python3 --version)"; \
	echo; echo "## Python packages"; echo; pip freeze; \
	echo; echo "## CLI"; echo; \
	echo "bash $(bash --version | head -1)"; echo "coreutils $(ls --version | head -1)"; \
	echo "gawk $(gawk --version | head -1)"; echo "ripgrep $(rg --version | head -1)"; \
	echo "jq $(jq --version)"; echo "yq $(yq --version)"; echo "duckdb $(duckdb --version)"; \
	echo "miller $(mlr --version)"; \
	echo; echo "## Licenses"; echo; \
	echo "Debian package licenses: /usr/share/doc/<package>/copyright. Python package licenses: pip show <package>."; \
	echo "yq: MIT. duckdb: MIT."; \
	} > /README.md

USER 1000:1000
WORKDIR /work
